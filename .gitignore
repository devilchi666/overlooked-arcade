# Rust
/target
**/target
**/*.rs.bk
Cargo.lock.bak

# Node / pnpm
/node_modules
/frontend/node_modules
/frontend/dist
/frontend/.vite
**/node_modules/.vite
**/.pnpm-store

# Tauri build output
/apps/oa-shell/target
/apps/oa-shell/gen
/apps/oa-shell/release

# Bindgen / cc-rs intermediate
**/*.o
**/*.obj
**/*.pdb
**/*.exp
**/*.lib
**/*.dll
**/*.so
**/*.dylib

# User-provided content (never commit)
/assets/test-roms
/assets/system-bios
# Third-party emulator binaries OA shells out to (MAME today; DOSBox-X /
# ScummVM standalone / etc. eventually). Project-wide convention: drop
# them under <root>/Emulators/<name>/. The shipped install applies the
# same shape at <exe_dir>/Emulators/. See tools/mame-extractor/README.md
# "Where to put MAME" for the canonical layout.
/Emulators

# Copyrighted runtime content (BIOSes + libretro cores + game ROMs).
# `target/` already catches the dev drop dirs (target/debug/cores,
# target/debug/system) but these belt-and-suspenders patterns ensure
# a misplaced file outside target/ can't be committed by accident.
# DLLs are already covered above; this section adds BIOS + ROM
# extensions across every recognized system.
**/cores/*.dll
**/cores/*.so
**/cores/*.dylib
**/system/*.pce
**/system/*.img
**/system/*.rom
syscard?.pce
syscard?j.pce
gexpress.pce
lynxboot.img
disksys.rom
# ROM dumps — every container we recognize in `is_cd_extension` /
# `systemForExtension`. The few legitimate `.cue` / `.bin` companion
# files we'd ever ship (none today) would need a force-add.
**/*.pce
**/*.nes
**/*.sfc
**/*.smc
**/*.fig
**/*.swc
**/*.lnx
**/*.lyx
**/*.fds
**/*.unf
**/*.unif
**/*.chd
**/*.cue
**/*.toc
**/*.ccd
**/*.m3u

# IDE / OS
.vscode
.idea
.claude/settings.local.json
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Scratch / spikes
/scripts/spikes
/tmp

# OS / editor specifics
*.log
.env
.env.local
